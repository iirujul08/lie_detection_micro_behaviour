# TruthLens Configuration Environment Variables

# Backend Port & Host
HOST=0.0.0.0
PORT=8000

# Database Connection (SQLite default)
DATABASE_URL=sqlite:///./truthlens.db

# Frontend URLs for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Kaggle Credentials for automated dataset download
KAGGLE_USERNAME=
KAGGLE_KEY=
